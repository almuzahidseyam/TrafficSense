<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF uses reflection and resources that are not safe to trim. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <Target Name="CopyPortableRuntimeNotices" AfterTargets="Publish">
    <ItemGroup>
      <_PortableNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE*;%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*">
        <Package>%(ResolvedRuntimePack.NuGetPackageId)</Package>
      </_PortableNotice>
    </ItemGroup>
    <Copy SourceFiles="@(_PortableNotice)"
          DestinationFiles="@(_PortableNotice->'$(PublishDir)licenses/%(Package)/%(Filename)%(Extension)')" />
  </Target>
</Project>
