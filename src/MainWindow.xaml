<Window x:Class="TrafficSense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="TrafficSense" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Focusable="True" PreviewKeyDown="Widget_PreviewKeyDown"
        Closing="Window_Closing">
    
    <Border Background="#60000000" CornerRadius="4" Margin="2" Padding="8,4">
        <Border.ContextMenu>
            <ContextMenu FontFamily="Segoe UI, Nirmala UI, Kalpurush">
                <MenuItem Header="Network adapter" x:Name="MenuNetworkAdapter" SubmenuOpened="MenuNetworkAdapter_Opened">
                    <MenuItem Header="Auto (one connection)" />
                </MenuItem>
                <MenuItem Header="Start with Windows" IsCheckable="True" x:Name="MenuAutoStart" Click="MenuAutoStart_Click" />
                <MenuItem Header="Lock position" IsCheckable="True" x:Name="MenuPositionLock" Click="MenuPositionLock_Click" />
                <MenuItem Header="Reset position" x:Name="MenuResetPosition" Click="MenuResetPosition_Click" />
                <MenuItem Header="Switch Theme (Light/Dark)" x:Name="MenuTheme" Click="MenuTheme_Click" />
                <MenuItem Header="Text size" x:Name="MenuFontSize" />
                <MenuItem Header="Background transparency" x:Name="MenuTransparency" />
                <MenuItem Header="Appearance presets" x:Name="MenuSkinPresets" />
                <MenuItem Header="Font" x:Name="MenuFontFamily" Click="MenuFontFamily_Click" />
                <MenuItem Header="Item colors" x:Name="MenuColors" />
                <MenuItem Header="Import skin" x:Name="MenuSkinImport" Click="MenuSkinImport_Click" />
                <MenuItem Header="Export skin" x:Name="MenuSkinExport" Click="MenuSkinExport_Click" />
                <MenuItem Header="Speed unit" x:Name="MenuSpeedUnit" />
                <MenuItem Header="Refresh interval" x:Name="MenuRefreshInterval" />
                <MenuItem Header="Display metrics" x:Name="MenuMetrics" />
                <MenuItem Header="System and connection details" x:Name="MenuSystemDetails" Click="MenuSystemDetails_Click" />
                <MenuItem Header="Sensor source" x:Name="MenuSensorSource">
                    <MenuItem Header="Open sensor bridge" x:Name="MenuSensorBridge" Click="MenuSensorBridge_Click" />
                    <MenuItem Header="Choose sensor JSON" x:Name="MenuChooseSensor" Click="MenuChooseSensor_Click" />
                    <MenuItem Header="Clear sensor source" x:Name="MenuClearSensor" Click="MenuClearSensor_Click" />
                </MenuItem>
                <MenuItem Header="Daily data alert" x:Name="MenuDailyLimit" />
                <MenuItem Header="Monthly data alert" x:Name="MenuMonthlyLimit" />
                <MenuItem Header="Taskbar-edge panel" x:Name="MenuTaskbarPanel" IsCheckable="True" Click="MenuTaskbarPanel_Click" />
                <MenuItem Header="Panel at top" x:Name="MenuPanelTop" IsCheckable="True" Click="MenuPanelTop_Click" />
                <MenuItem Header="Panel monitor" x:Name="MenuPanelMonitor" SubmenuOpened="MenuPanelMonitor_Opened" />
                <MenuItem Header="Global shortcut (Ctrl+Alt+T)" x:Name="MenuShortcut" IsCheckable="True" Click="MenuShortcut_Click" />
                <MenuItem Header="Language" x:Name="MenuLanguage">
                    <MenuItem Header="English" x:Name="MenuEnglish" Tag="en" IsCheckable="True" Click="MenuLanguage_Click" />
                    <MenuItem Header="বাংলা" x:Name="MenuBangla" Tag="bn" IsCheckable="True" Click="MenuLanguage_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Settings backup" x:Name="MenuSettingsBackup">
                    <MenuItem Header="Back up settings…" x:Name="MenuBackup" Click="MenuBackup_Click" />
                    <MenuItem Header="Restore settings…" x:Name="MenuRestore" Click="MenuRestore_Click" />
                </MenuItem>
                <MenuItem Header="About TrafficSense" x:Name="MenuAbout" Click="MenuAbout_Click" />
                <MenuItem Header="Usage and history" x:Name="MenuHistory" Click="MenuHistory_Click" />
                <MenuItem Header="Hide widget" x:Name="MenuHide" Click="MenuHide_Click" />
                <MenuItem Header="Exit" x:Name="MenuExit" Click="MenuExit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Download -->
            <ui:SymbolIcon x:Name="IconDownload" Symbol="ArrowDownload24" Foreground="#4CAF50" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" FontSize="16" />
            <TextBlock x:Name="TxtDownload" Text="0.00 KB/s" Grid.Row="0" Grid.Column="1" Foreground="White" FontFamily="Segoe UI, Kalpurush, Arial" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <!-- Upload -->
            <ui:SymbolIcon x:Name="IconUpload" Symbol="ArrowUpload24" Foreground="#2196F3" Grid.Row="1" Grid.Column="0" Margin="0,4,8,0" FontSize="16" />
            <TextBlock x:Name="TxtUpload" Text="0.00 KB/s" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="White" FontFamily="Segoe UI, Kalpurush, Arial" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtMetrics" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="Collapsed"
                       Foreground="White" FontFamily="Segoe UI, Nirmala UI" FontSize="14" TextWrapping="Wrap" MaxWidth="360" />
            <TextBlock x:Name="TxtSampleState" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Visibility="Collapsed"
                       Foreground="White" FontFamily="Segoe UI, Nirmala UI" FontSize="12" TextWrapping="Wrap" MaxWidth="120" />
        </Grid>
    </Border>
</Window>
